@using AvailabilityCollector.Models
@{
    ViewData["Title"] = "Zgodovina - " + ViewBag.MonthKey;
    var daysInMonth = (int)ViewBag.DaysInMonth;
    var firstDay = (DateOnly)ViewBag.FirstDay;
    var holidays = ViewBag.Holidays as List<Holiday> ?? new List<Holiday>();
    var submission = ViewBag.Submission as AvailabilitySubmission;
    var monthKey = ViewBag.MonthKey as string;
    
    // Parse month parts
    var monthParts = monthKey.Split('-');
    var year = int.Parse(monthParts[1]);
    var monthNum = int.Parse(monthParts[0]);
    
    // Create set of holiday dates
    var holidayDates = holidays.Select(h => h.Date).ToHashSet();
    
    // Load existing entries
    var existingEntries = new Dictionary<DateOnly, AvailabilityEntry>();
    foreach (var entry in submission.Entries)
    {
        existingEntries[entry.Date] = entry;
    }
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Zgodovina razpoložljivosti - @monthKey</h1>
        <div>
            <a href="@Url.Action("Zgodovina", "Worker")" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Nazaj
            </a>
        </div>
    </div>

    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Samo pregled oddane razpoložljivosti. Urejanje ni mogoče.
        <br />Oddano: @submission.SubmittedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
    </div>

    <!-- Calendar Grid -->
    <div class="card mb-3">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-sm">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 14.28%;">Pon</th>
                            <th style="width: 14.28%;">Tor</th>
                            <th style="width: 14.28%;">Sre</th>
                            <th style="width: 14.28%;">Čet</th>
                            <th style="width: 14.28%;">Pet</th>
                            <th style="width: 14.28%;">Sob</th>
                            <th style="width: 14.28%;">Ned</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var currentDate = firstDay;
                            var weekRow = 0;
                            while (currentDate <= firstDay.AddMonths(1).AddDays(-1))
                            {
                                if (currentDate.DayOfWeek == DayOfWeek.Monday || weekRow == 0)
                                {
                                    @:<tr>
                                    weekRow++;
                                }
                                
                                var dayNum = currentDate.Day;
                                var isHoliday = holidayDates.Contains(currentDate);
                                var dayOfWeek = currentDate.DayOfWeek;
                                var isWeekend = dayOfWeek == DayOfWeek.Saturday || dayOfWeek == DayOfWeek.Sunday;
                                var isCurrentMonth = currentDate >= firstDay && currentDate <= firstDay.AddMonths(1).AddDays(-1);
                                var entry = existingEntries.ContainsKey(currentDate) ? existingEntries[currentDate] : null;
                                
                                string cellClass = "text-center";
                                if (!isCurrentMonth)
                                {
                                    cellClass += " text-muted bg-light";
                                }
                                else if (isWeekend || isHoliday)
                                {
                                    cellClass += " bg-secondary bg-opacity-10";
                                }
                                
                                string cellContent = "";
                                string tooltip = "";
                                
                                if (entry != null)
                                {
                                    switch (entry.Type)
                                    {
                                        case AvailabilityType.FullDay:
                                            cellClass += " bg-success text-white";
                                            cellContent = "<div style='font-weight: bold;'>" + dayNum + "</div><small>✓</small>";
                                            tooltip = "Na voljo cel dan";
                                            break;
                                        case AvailabilityType.TimeRange:
                                            cellClass += " bg-warning";
                                            cellContent = "<div style='font-weight: bold;'>" + dayNum + "</div><small>◐</small>";
                                            var timeRange = (entry.StartTime?.ToString("HH:mm") ?? "") + "-" + (entry.EndTime?.ToString("HH:mm") ?? "");
                                            cellContent += "<div style='font-size: 0.7em; margin-top: 2px;' class='time-display'>" + timeRange + "</div>";
                                            tooltip = $"Delno: {timeRange}";
                                            break;
                                        case AvailabilityType.Unavailable:
                                            cellClass += " bg-danger text-white";
                                            cellContent = "<div style='font-weight: bold;'>" + dayNum + "</div><small>✗</small>";
                                            tooltip = "Ni na voljo";
                                            break;
                                    }
                                }
                                else if (isCurrentMonth)
                                {
                                    cellContent = "<div style='font-weight: bold;'>" + dayNum + "</div>";
                                    tooltip = "Ni oddane razpoložljivosti";
                                }
                                
                                if (isHoliday && isCurrentMonth)
                                {
                                    var holiday = holidays.FirstOrDefault(h => h.Date == currentDate);
                                    cellContent += "<div style='font-size: 0.65em; margin-top: 2px;' class='text-muted'>" + (holiday?.Name ?? "") + "</div>";
                                }
                                
                                <td class="@cellClass" 
                                    title="@tooltip"
                                    style="min-height: 60px; position: relative;"
                                    @(entry?.Type == AvailabilityType.TimeRange && isCurrentMonth ? $"onclick=\"showTimeRange('{entry.StartTime?.ToString("HH:mm")}', '{entry.EndTime?.ToString("HH:mm")}')\"" : "")>
                                    @Html.Raw(cellContent)
                                </td>
                                
                                if (dayOfWeek == DayOfWeek.Sunday)
                                {
                                    @:</tr>
                                }
                                
                                currentDate = currentDate.AddDays(1);
                            }
                            
                            // Close last row if needed
                            if (currentDate.DayOfWeek != DayOfWeek.Monday)
                            {
                                var remainingDays = 7 - (int)currentDate.AddDays(-1).DayOfWeek;
                                for (int i = 0; i < remainingDays; i++)
                                {
                                    <td class="text-muted bg-light" style="min-height: 60px;"></td>
                                }
                                @:</tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Legend -->
    <div class="card mb-3">
        <div class="card-body">
            <strong>Legenda:</strong>
            <div class="d-flex flex-wrap gap-3 mt-2">
                <div><span class="badge bg-success text-white me-1">✓</span> Na voljo</div>
                <div><span class="badge bg-warning me-1">◐</span> Delno (kliknite za čas)</div>
                <div><span class="badge bg-danger text-white me-1">✗</span> Ni na voljo</div>
                <div><span class="text-muted">Sivo</span> Vikend/Praznik</div>
            </div>
        </div>
    </div>
</div>

<!-- Time Range Modal -->
<div class="modal fade" id="timeRangeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Časovni razpon</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p><strong>Od:</strong> <span id="modalStartTime"></span></p>
                <p><strong>Do:</strong> <span id="modalEndTime"></span></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Zapri</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showTimeRange(startTime, endTime) {
            document.getElementById('modalStartTime').textContent = startTime || '';
            document.getElementById('modalEndTime').textContent = endTime || '';
            const modal = new bootstrap.Modal(document.getElementById('timeRangeModal'));
            modal.show();
        }
    </script>
}
