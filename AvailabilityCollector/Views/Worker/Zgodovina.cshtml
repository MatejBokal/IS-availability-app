@model List<AvailabilityCollector.Models.AvailabilitySubmission>
@{
    ViewData["Title"] = "Zgodovina";
}

<div class="container mt-4">
    <h1 class="mb-4">Zgodovina razpoložljivosti</h1>
    
    @if (Model.Any())
    {
        <div class="list-group">
            @foreach (var submission in Model)
            {
                <a href="@Url.Action("ZgodovinaMesec", "Worker", new { monthKey = submission.AvailabilityMonth.MonthKey })" 
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-1">@submission.AvailabilityMonth.MonthKey</h5>
                        <small class="text-muted">
                            Oddano: @submission.SubmittedAtUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                        </small>
                    </div>
                    <i class="bi bi-chevron-right"></i>
                </a>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <p>Nimate še oddanih razpoložljivosti.</p>
        </div>
    }

    <div class="mt-4">
        <a href="@Url.Action("Index", "Dashboard")" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Nazaj
        </a>
    </div>
</div>
