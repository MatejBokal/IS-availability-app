@model List<AvailabilityCollector.Models.Holiday>
@{
    ViewData["Title"] = "Splošne nastavitve";
}

<div class="container mt-4">
    <h1 class="mb-4">Splošne nastavitve</h1>
    
    <div class="card mb-4">
        <div class="card-header">
            <h5>Prazniki</h5>
        </div>
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span>Upravljanje praznikov za izračun mesečnih kvot</span>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addHolidayModal">
                    <i class="bi bi-plus-circle"></i> Dodaj praznik
                </button>
            </div>
            
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Ime</th>
                            <th>Datum</th>
                            <th>Leto</th>
                            <th>Akcije</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var holiday in Model)
                        {
                            <tr>
                                <td>@holiday.Name</td>
                                <td>@holiday.Date.ToString("dd.MM.yyyy")</td>
                                <td>@holiday.Year</td>
                                <td>
                                    <button class="btn btn-sm btn-danger" onclick="deleteHoliday(@holiday.Id, event)">Izbriši</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    
    <div class="card">
        <div class="card-header">
            <h5>Druge nastavitve</h5>
        </div>
        <div class="card-body">
            <div class="alert alert-info">
                <p>Dodatne nastavitve (zaklepanje razpoložljivosti, obvestila, opomniki) bodo na voljo kmalu.</p>
            </div>
        </div>
    </div>
</div>

<!-- Add Holiday Modal -->
<div class="modal fade" id="addHolidayModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Dodaj praznik</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Admin" asp-action="AddHoliday" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Ime praznika:</label>
                        <input type="text" name="name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Datum:</label>
                        <input type="date" name="date" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Prekliči</button>
                    <button type="submit" class="btn btn-primary">Dodaj</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function deleteHoliday(id, event) {
            if (!confirm('Ali ste prepričani, da želite izbrisati ta praznik?')) {
                return;
            }

            try {
                const response = await fetch('/admin/delete-holiday', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(id)
                });

                const result = await response.json();
                
                if (result.success) {
                    // Show success message
                    const toast = document.createElement('div');
                    toast.className = 'alert alert-success alert-dismissible fade show position-fixed top-0 end-0 m-3';
                    toast.style.zIndex = '9999';
                    toast.innerHTML = `
                        ${result.message || 'Praznik je bil uspešno izbrisan.'}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    `;
                    document.body.appendChild(toast);
                    
                    // Remove the row from the table
                    const row = event.target.closest('tr');
                    if (row) {
                        row.remove();
                    }
                    
                    // Auto-remove toast after 3 seconds
                    setTimeout(() => {
                        toast.remove();
                    }, 3000);
                } else {
                    alert('Napaka: ' + (result.message || 'Neznana napaka'));
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Napaka pri brisanju praznika.');
            }
        }
    </script>
}
