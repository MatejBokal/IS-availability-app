@model List<AvailabilityCollector.Models.Holiday>
@{
    ViewData["Title"] = "Splošne nastavitve";
}

<div class="container mt-4">
    <h1 class="mb-4">Splošne nastavitve</h1>
    
    <div class="card mb-4">
        <div class="card-header">
            <h5>Prazniki</h5>
        </div>
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span>Upravljanje praznikov za izračun mesečnih kvot</span>
                <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addHolidayModal">
                    <i class="bi bi-plus-circle"></i> Dodaj praznik
                </button>
            </div>
            
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Ime</th>
                            <th>Datum</th>
                            <th>Leto</th>
                            <th>Akcije</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var holiday in Model)
                        {
                            <tr>
                                <td>@holiday.Name</td>
                                <td>@holiday.Date.ToString("dd.MM.yyyy")</td>
                                <td>@holiday.Year</td>
                                <td>
                                    <button class="btn btn-sm btn-danger" onclick="deleteHoliday(@holiday.Id, event)">Izbriši</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    
    <div class="card mb-4">
        <div class="card-header">
            <h5>Nastavitve razpoložljivosti</h5>
        </div>
        <div class="card-body">
            <form id="settingsForm">
                <div class="mb-3">
                    <label for="allowedStartTime" class="form-label">Dovoljeni časovni razpon - Začetek:</label>
                    <input type="time" id="allowedStartTime" class="form-control" value="@ViewBag.AllowedStartTime" required />
                    <small class="form-text text-muted">Začetni čas dovoljenega časovnega razpona za razpoložljivost (npr. 07:00).</small>
                </div>
                
                <div class="mb-3">
                    <label for="allowedEndTime" class="form-label">Dovoljeni časovni razpon - Konec:</label>
                    <input type="time" id="allowedEndTime" class="form-control" value="@ViewBag.AllowedEndTime" required />
                    <small class="form-text text-muted">Končni čas dovoljenega časovnega razpona za razpoložljivost (npr. 23:00).</small>
                </div>
                
                <div class="mb-3">
                    <label for="minTimeRangeHours" class="form-label">Minimalna dolžina časovnega razpona (ure):</label>
                    <input type="number" id="minTimeRangeHours" class="form-control" min="1" max="24" step="0.5" value="@ViewBag.MinTimeRangeHours" required />
                    <small class="form-text text-muted">Minimalna dolžina časovnega razpona za "Delno" razpoložljivost (v urah).</small>
                </div>
                
                <div class="mb-3">
                    <label for="autoLockDayOfMonth" class="form-label">Avtomatsko zaklepanje (dan v mesecu):</label>
                    <input type="number" id="autoLockDayOfMonth" class="form-control" min="1" max="31" step="1" value="@ViewBag.AutoLockDayOfMonth" required />
                    <small class="form-text text-muted">Dan v prejšnjem mesecu, ko se mesec avtomatsko zaklene (npr. 25 = zaklenjeno 25. prejšnjega meseca). Če ni nastavljeno, privzeto je 1. dan meseca (zaklenjeno ob začetku meseca).</small>
                </div>
                
                <div class="mb-3">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="enableAdminNotifications" @(ViewBag.EnableAdminNotifications == true ? "checked" : "")>
                        <label class="form-check-label" for="enableAdminNotifications">
                            Omogoči obvestila za administratorje
                        </label>
                    </div>
                    <small class="form-text text-muted">Če je omogočeno, administratorji bodo prejemali obvestila ob odklenitvi meseca.</small>
                </div>
                
                <div class="mb-3">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="lockAfterInitialSubmission" @(ViewBag.LockAfterInitialSubmission == true ? "checked" : "")>
                        <label class="form-check-label" for="lockAfterInitialSubmission">
                            Zakleni oddajo po prvi oddaji
                        </label>
                    </div>
                    <small class="form-text text-muted">Če je omogočeno, delavci ne morejo več urejati oddaje po prvi oddaji (do zaklepanja meseca).</small>
                </div>
                
                <button type="button" class="btn btn-primary" onclick="saveSettings()">
                    <i class="bi bi-save"></i> Shrani nastavitve
                </button>
            </form>
        </div>
    </div>
    
    <div class="card mb-4">
        <div class="card-header">
            <h5>Obvestila</h5>
        </div>
        <div class="card-body">
            <form id="notificationSettingsForm">
                <div class="mb-3">
                    <label for="daysBeforeLockForReminder" class="form-label">Dnevi pred zaklepanjem za opomnik:</label>
                    <input type="number" id="daysBeforeLockForReminder" class="form-control" min="1" max="30" step="1" value="@ViewBag.DaysBeforeLockForReminder" required />
                    <small class="form-text text-muted">Število dni pred zaklepanjem meseca, ko se pošlje prvo obvestilo o zaklepanju. Dnevi pred tem se bodo pošiljali opomniki delavcem, ki še niso oddali razpoložljivosti (npr. 5 = prvo obvestilo 5 dni pred zaklepanjem, opomniki 4, 3, 2, 1 dan pred zaklepanjem).</small>
                </div>
                
                <button type="button" class="btn btn-primary" onclick="saveSettings()">
                    <i class="bi bi-save"></i> Shrani nastavitve
                </button>
            </form>
        </div>
    </div>
</div>

<!-- Add Holiday Modal -->
<div class="modal fade" id="addHolidayModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Dodaj praznik</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Admin" asp-action="AddHoliday" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Ime praznika:</label>
                        <input type="text" name="name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Datum:</label>
                        <input type="date" name="date" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Prekliči</button>
                    <button type="submit" class="btn btn-primary">Dodaj</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function deleteHoliday(id, event) {
            if (!confirm('Ali ste prepričani, da želite izbrisati ta praznik?')) {
                return;
            }

            try {
                const response = await fetch('/admin/delete-holiday', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(id)
                });

                const result = await response.json();
                
                if (result.success) {
                    // Show success message
                    const toast = document.createElement('div');
                    toast.className = 'alert alert-success alert-dismissible fade show position-fixed top-0 end-0 m-3';
                    toast.style.zIndex = '9999';
                    toast.innerHTML = `
                        ${result.message || 'Praznik je bil uspešno izbrisan.'}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    `;
                    document.body.appendChild(toast);
                    
                    // Remove the row from the table
                    const row = event.target.closest('tr');
                    if (row) {
                        row.remove();
                    }
                    
                    // Auto-remove toast after 3 seconds
                    setTimeout(() => {
                        toast.remove();
                    }, 3000);
                } else {
                    alert('Napaka: ' + (result.message || 'Neznana napaka'));
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Napaka pri brisanju praznika.');
            }
        }

        async function saveSettings() {
            const allowedStartTime = document.getElementById('allowedStartTime').value;
            const allowedEndTime = document.getElementById('allowedEndTime').value;
            const minTimeRangeHours = parseFloat(document.getElementById('minTimeRangeHours').value);
            const autoLockDayOfMonth = parseInt(document.getElementById('autoLockDayOfMonth').value);
            const lockAfterSubmission = document.getElementById('lockAfterInitialSubmission').checked;
            const enableAdminNotifications = document.getElementById('enableAdminNotifications').checked;
            const daysBeforeLockForReminder = parseInt(document.getElementById('daysBeforeLockForReminder').value);
            
            if (!allowedStartTime || !allowedEndTime) {
                alert('Prosimo, vnesite veljavna začetna in končna časa.');
                return;
            }

            // Validate that end time is after start time
            const startTime = new Date('2000-01-01T' + allowedStartTime);
            const endTime = new Date('2000-01-01T' + allowedEndTime);
            if (endTime <= startTime) {
                alert('Končni čas mora biti za začetnim časom.');
                return;
            }
            
            if (isNaN(minTimeRangeHours) || minTimeRangeHours < 1 || minTimeRangeHours > 24) {
                alert('Prosimo, vnesite veljavno število ur (1-24).');
                return;
            }

            if (isNaN(autoLockDayOfMonth) || autoLockDayOfMonth < 1 || autoLockDayOfMonth > 31) {
                alert('Prosimo, vnesite veljavno število dni (1-31).');
                return;
            }

            if (isNaN(daysBeforeLockForReminder) || daysBeforeLockForReminder < 1 || daysBeforeLockForReminder > 30) {
                alert('Prosimo, vnesite veljavno število dni (1-30).');
                return;
            }

            try {
                const response = await fetch('/admin/save-settings', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        allowedStartTime: allowedStartTime,
                        allowedEndTime: allowedEndTime,
                        minTimeRangeHours: minTimeRangeHours,
                        autoLockDayOfMonth: autoLockDayOfMonth,
                        lockAfterInitialSubmission: lockAfterSubmission,
                        enableAdminNotifications: enableAdminNotifications,
                        daysBeforeLockForReminder: daysBeforeLockForReminder
                    })
                });

                const result = await response.json();
                
                if (result.success) {
                    const toast = document.createElement('div');
                    toast.className = 'alert alert-success alert-dismissible fade show position-fixed top-0 end-0 m-3';
                    toast.style.zIndex = '9999';
                    toast.innerHTML = `
                        Nastavitve so bile uspešno shranjene.
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    `;
                    document.body.appendChild(toast);
                    
                    setTimeout(() => {
                        toast.remove();
                    }, 3000);
                } else {
                    alert('Napaka: ' + (result.message || 'Nekatere nastavitve niso bile shranjene.'));
                }
            } catch (error) {
                console.error('Error:', error);
                alert('Napaka pri shranjevanju nastavitev.');
            }
        }
    </script>
}
