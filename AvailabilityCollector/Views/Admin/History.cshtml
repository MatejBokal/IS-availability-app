@model List<AvailabilityCollector.Models.AvailabilityMonth>
@{
    ViewData["Title"] = "Zgodovina razpoložljivosti";
}

<div class="container mt-4">
    <h1 class="mb-4">Zgodovina razpoložljivosti</h1>
    
    <div class="list-group">
        @foreach (var month in Model)
        {
            <a href="@Url.Action("Availability", "Admin", new { monthKey = month.MonthKey })" 
               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-1">@month.MonthKey</h5>
                    <small class="text-muted">
                        @if (month.IsUnlocked)
                        {
                            <span class="badge bg-success">Odklenjeno</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Zaklenjeno</span>
                        }
                        @if (month.LockDateTimeUtc.HasValue)
                        {
                            <span> - Zaklenjeno: @month.LockDateTimeUtc.Value.ToString("dd.MM.yyyy HH:mm")</span>
                        }
                    </small>
                </div>
                <i class="bi bi-chevron-right"></i>
            </a>
        }
    </div>
    
    <div class="mt-4">
        <a href="@Url.Action("Razpolozljivosti", "Admin")" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Nazaj
        </a>
    </div>
</div>
