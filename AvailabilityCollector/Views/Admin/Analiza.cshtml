@model AvailabilityCollector.Controllers.AnalyticsViewModel
@using AvailabilityCollector.Models
@{
    ViewData["Title"] = "Analiza - " + Model.MonthKey;
    var culture = new System.Globalization.CultureInfo("sl-SI");
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Analiza - @Model.MonthKey</h1>
        <a href="@Url.Action("Availability", "Admin", new { monthKey = Model.MonthKey })" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Nazaj na razpoložljivost
        </a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i> @ViewBag.Error
        </div>
    }
    else
    {
        <!-- Summary Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title text-muted">Nepokrite izmene</h5>
                        <h2 class="text-danger">@Model.TotalUncoveredShifts</h2>
                        <small class="text-muted">od @Model.TotalRequiredShifts skupno</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title text-muted">Dnevi s premalo zaposlenimi</h5>
                        <h2 class="text-warning">@Model.DaysWithInsufficientCoverage.Count</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title text-muted">Odstotek pokritih izmen</h5>
                        <h2 class="@(Model.CoveragePercentage >= 80 ? "text-success" : Model.CoveragePercentage >= 50 ? "text-warning" : "text-danger")">@Model.CoveragePercentage%</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card text-center">
                    <div class="card-body">
                        <h5 class="card-title text-muted">Redno zaposleni z nezadostno razpoložljivostjo</h5>
                        <h2 class="text-warning">@Model.RegularEmployeesWithInsufficientAvailability.Count</h2>
                    </div>
                </div>
            </div>
        </div>

        <!-- Days with Insufficient Coverage -->
        @if (Model.DaysWithInsufficientCoverage.Any())
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-calendar-x"></i> Dnevi s premalo zaposlenimi</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Ti dnevi imajo premalo zaposlenih za pokritje vseh izmen, kljub temu da so posamezne izmene pokriti.</p>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var date in Model.DaysWithInsufficientCoverage)
                        {
                            <span class="badge bg-warning text-dark">@date.ToString("dd.MM.yyyy", culture) (@date.ToString("dddd", culture))</span>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Uncovered Shifts -->
        @if (Model.UncoveredShifts.Any())
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-exclamation-circle"></i> Nepokrite izmene</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Datum</th>
                                    <th>Pozicija</th>
                                    <th>Čas izmene</th>
                                    <th class="text-center">Potrebno oseb</th>
                                    <th class="text-center">Na voljo oseb</th>
                                    <th class="text-center">Primanjkuje</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var shift in Model.UncoveredShifts)
                                {
                                    <tr>
                                        <td>@shift.Date.ToString("dd.MM.yyyy", culture)<br /><small class="text-muted">@shift.Date.ToString("dddd", culture)</small></td>
                                        <td><strong>@shift.PositionName</strong></td>
                                        <td>@shift.ShiftTime</td>
                                        <td class="text-center">@shift.RequiredPeople</td>
                                        <td class="text-center">@shift.AvailablePeople</td>
                                        <td class="text-center"><span class="badge bg-danger">@shift.Gap</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card mb-4">
                <div class="card-body text-center">
                    <i class="bi bi-check-circle text-success" style="font-size: 3rem;"></i>
                    <h5 class="mt-3">Vse izmene so pokrite</h5>
                    <p class="text-muted">Ni nepokritih izmen za ta mesec.</p>
                </div>
            </div>
        }

        <!-- Regular Employees with Insufficient Availability -->
        @if (Model.RegularEmployeesWithInsufficientAvailability.Any())
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-people"></i> Redno zaposleni z nezadostno razpoložljivostjo</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Pričakovano število dni: @Model.RegularEmployeesWithInsufficientAvailability.First().ExpectedDays (dnevi v mesecu - vikendi - prazniki)</p>
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Zaposleni</th>
                                    <th>Pozicija</th>
                                    <th class="text-center">Pričakovano dni</th>
                                    <th class="text-center">Na voljo dni</th>
                                    <th class="text-center">Primanjkuje</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var employee in Model.RegularEmployeesWithInsufficientAvailability)
                                {
                                    <tr>
                                        <td><strong>@employee.EmployeeName</strong></td>
                                        <td>@employee.Position</td>
                                        <td class="text-center">@employee.ExpectedDays</td>
                                        <td class="text-center">@employee.AvailableDays</td>
                                        <td class="text-center"><span class="badge bg-warning">@employee.Gap</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card mb-4">
                <div class="card-body text-center">
                    <i class="bi bi-check-circle text-success" style="font-size: 3rem;"></i>
                    <h5 class="mt-3">Vsi redno zaposleni imajo zadostno razpoložljivost</h5>
                    <p class="text-muted">Vsi redno zaposleni so na voljo za pričakovano število dni.</p>
                </div>
            </div>
        }
    }
</div>
