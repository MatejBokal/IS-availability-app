@model List<AvailabilityCollector.Models.AvailabilityMonth>
@{
    ViewData["Title"] = "Prihajajoče razpoložljivosti";
    var nextMonthKey = ViewBag.NextMonthKey as string;
    var monthAfterNextKey = ViewBag.MonthAfterNextKey as string;
}

<div class="container mt-4">
    <h1 class="mb-4">Prihajajoče razpoložljivosti</h1>
    
    <div class="list-group mb-4">
        @if (Model.Any(m => m.MonthKey == nextMonthKey))
        {
            <a href="@Url.Action("Availability", "Admin", new { monthKey = nextMonthKey })" 
               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-1">@nextMonthKey</h5>
                    <small class="text-muted">Naslednji mesec</small>
                </div>
                <i class="bi bi-chevron-right"></i>
            </a>
        }
        else
        {
            <div class="list-group-item">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="mb-1">@nextMonthKey</h5>
                        <small class="text-muted">Ni še odklenjeno</small>
                    </div>
                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#unlockModal" data-month="@nextMonthKey">
                        Odkleni
                    </button>
                </div>
            </div>
        }
        
        @foreach (var month in Model.Where(m => m.MonthKey != nextMonthKey).OrderBy(m => m.MonthKey))
        {
            <a href="@Url.Action("Availability", "Admin", new { monthKey = month.MonthKey })" 
               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="mb-1">@month.MonthKey</h5>
                    <small class="text-muted">
                        @if (month.IsUnlocked)
                        {
                            <span class="badge bg-success">Odklenjeno</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Zaklenjeno</span>
                        }
                    </small>
                </div>
                <i class="bi bi-chevron-right"></i>
            </a>
        }
    </div>
    
    <div class="mt-4">
        <a href="@Url.Action("Razpolozljivosti", "Admin")" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Nazaj
        </a>
    </div>
</div>

<!-- Unlock Month Modal -->
<div class="modal fade" id="unlockModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Odkleni mesec</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Admin" asp-action="UnlockMonth" method="post">
                <div class="modal-body">
                    <input type="hidden" name="monthKey" id="unlockMonthKey" />
                    <div class="mb-3">
                        <label class="form-label">Mesec:</label>
                        <input type="text" class="form-control" id="unlockMonthDisplay" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">
                            <input type="checkbox" name="sendNotification" value="true" />
                            Pošlji obvestilo zaposlenim
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Prekliči</button>
                    <button type="submit" class="btn btn-primary">Odkleni</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var unlockModal = document.getElementById('unlockModal');
        unlockModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var monthKey = button.getAttribute('data-month');
            document.getElementById('unlockMonthKey').value = monthKey;
            document.getElementById('unlockMonthDisplay').value = monthKey;
        });
    </script>
}
