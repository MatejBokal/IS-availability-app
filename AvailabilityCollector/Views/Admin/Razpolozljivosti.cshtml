@{
    ViewData["Title"] = "Razpoložljivosti";
}

<div class="container mt-4">
    <h1 class="mb-4">Razpoložljivosti</h1>
    
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <a href="@Url.Action("History", "Admin")" class="btn btn-primary btn-lg w-100 py-3">
                <i class="bi bi-clock-history"></i><br />
                Zgodovina
            </a>
        </div>
        <div class="col-md-6">
            <a href="@Url.Action("Prihajajoce", "Admin")" class="btn btn-success btn-lg w-100 py-3">
                <i class="bi bi-calendar3-range"></i><br />
                Prihajajoče
            </a>
        </div>
    </div>
    
    <div class="text-center mt-4">
        <a href="@Url.Action("Availability", "Admin")" class="btn btn-outline-primary">
            <i class="bi bi-calendar-check"></i> Aktualno
        </a>
    </div>
</div>
