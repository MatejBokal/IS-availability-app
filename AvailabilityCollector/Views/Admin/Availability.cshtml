@model AvailabilityCollector.Controllers.AvailabilityTableViewModel
@using AvailabilityCollector.Models
@{
    ViewData["Title"] = "Razpoložljivost - " + Model.MonthKey;
    var positions = ViewBag.Positions as List<Position> ?? new List<Position>();
    var employmentTypes = ViewBag.EmploymentTypes as List<EmploymentType> ?? new List<EmploymentType>();
    var month = ViewBag.Month as AvailabilityMonth;
    var holidays = ViewBag.Holidays as List<Holiday> ?? new List<Holiday>();
    
    // Parse month to get days
    var monthParts = Model.MonthKey.Split('-');
    var year = int.Parse(monthParts[1]);
    var monthNum = int.Parse(monthParts[0]);
    var firstDay = new DateOnly(year, monthNum, 1);
    var lastDay = firstDay.AddMonths(1).AddDays(-1);
    var daysInMonth = lastDay.Day;
    
    // Create dictionary for quick lookup
    var submissionDict = Model.Submissions.ToDictionary(s => s.UserId);
    
    // Create set of holiday dates for quick lookup
    var holidayDates = holidays.Select(h => h.Date).ToHashSet();
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Razpoložljivost - @Model.MonthKey</h1>
        <div>
            <a href="@Url.Action("Razpolozljivosti", "Admin")" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Poglej ostale oddaje
            </a>
        </div>
    </div>
    
    <!-- Filters -->
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <select id="positionFilter" class="form-select">
                        <option value="">Vse pozicije</option>
                        @foreach (var pos in positions)
                        {
                            <option value="@pos.Name">@pos.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <select id="employmentTypeFilter" class="form-select">
                        <option value="">Vse zaposlitve</option>
                        <option value="RednoZaposleni">Redno zaposleni</option>
                        <option value="Studenti">Študenti</option>
                        <option value="SP">s.p.</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="button" class="btn btn-secondary w-100" onclick="clearFilters()">
                        <i class="bi bi-x-circle"></i> Počisti filtre
                    </button>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Availability Table -->
    <div class="table-responsive">
        <table class="table table-bordered table-sm" id="availabilityTable">
            <thead class="table-light sticky-top ">
                <tr>
                    <th style="min-width: 150px; position: sticky; left: 0; background: white; z-index: 10;">Zaposleni</th>
                    @for (int day = 1; day <= daysInMonth; day++)
                    {
                        var date = new DateOnly(year, monthNum, day);
                        var dayOfWeek = date.DayOfWeek;
                        var isWeekend = dayOfWeek == DayOfWeek.Saturday || dayOfWeek == DayOfWeek.Sunday;
                        var isHoliday = holidayDates.Contains(date);
                        var isSpecialDay = isWeekend || isHoliday;
                        <th class="text-center @(isSpecialDay ? "bg-secondary bg-opacity-25" : "")" style="min-width: 60px;">
                            <div>@day</div>
                            <small class="text-muted">@date.ToString("ddd", new System.Globalization.CultureInfo("sl-SI"))</small>
                            @if (isHoliday)
                            {
                                var holiday = holidays.FirstOrDefault(h => h.Date == date);
                                <br /><small class="text-muted" style="font-size: 0.7em;">@(holiday?.Name ?? "")</small>
                            }
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var employee in Model.Employees)
                {
                    var submission = submissionDict.ContainsKey(employee.Id) ? submissionDict[employee.Id] : null;
                    var entriesDict = submission?.Entries.ToDictionary(e => e.Date) ?? new Dictionary<DateOnly, AvailabilityEntry>();
                    
                    <tr data-position="@(employee.Position ?? "")" 
                        data-employment-type="@(employee.EmploymentType?.ToString() ?? "")"
                        class="employee-row">
                        <td style="position: sticky; left: 0; background: white; z-index: 5;">
                            <strong>@(employee.FirstName ?? "") @(employee.LastName ?? "")</strong><br />
                            <small class="text-muted">
                                @*@(employee.Position ?? "Ni pozicije") | 
                                @(employee.EmploymentType?.ToString() ?? "Ni določeno")*@
                            </small>
                        </td>
                        @for (int day = 1; day <= daysInMonth; day++)
                        {
                            var date = new DateOnly(year, monthNum, day);
                            var entry = entriesDict.ContainsKey(date) ? entriesDict[date] : null;
                            var dayOfWeek = date.DayOfWeek;
                            var isWeekend = dayOfWeek == DayOfWeek.Saturday || dayOfWeek == DayOfWeek.Sunday;
                            var isHoliday = holidayDates.Contains(date);
                            var isSpecialDay = isWeekend || isHoliday;
                            
                            string cellClass = "text-center";
                            string cellContent = "";
                            string title = "";
                            
                            if (entry == null)
                            {
                                // For empty cells, use grey background if weekend/holiday, otherwise white
                                if (isSpecialDay)
                                {
                                    cellClass += " bg-secondary bg-opacity-10";
                                }
                                else
                                {
                                    cellClass += " bg-white";
                                }
                                cellContent = "-";
                                title = "Ni oddane razpoložljivosti";
                            }
                            else
                            {
                                switch (entry.Type)
                                {
                                    case AvailabilityType.FullDay:
                                        cellClass += " bg-success text-white";
                                        cellContent = "✓";
                                        title = "Na voljo cel dan";
                                        break;
                                    case AvailabilityType.TimeRange:
                                        cellClass += " bg-warning";
                                        cellContent = "◐";
                                        title = $"Na voljo: {entry.StartTime?.ToString("HH:mm")} - {entry.EndTime?.ToString("HH:mm")}";
                                        break;
                                    case AvailabilityType.Unavailable:
                                        cellClass += " bg-danger text-white";
                                        cellContent = "✗";
                                        title = "Ni na voljo";
                                        break;
                                }
                                
                                // For cells with entries on weekends/holidays, add grey overlay
                                if (isSpecialDay)
                                {
                                    cellClass += " bg-secondary bg-opacity-10";
                                }
                            }
                            
                            <td class="@cellClass" title="@title">
                                @cellContent
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    
    <div class="d-flex justify-content-end mt-3">
        <a href="@Url.Action("Analiza", "Admin", new { monthKey = Model.MonthKey })" class="btn btn-info">
            <i class="bi bi-graph-up"></i> Analiza
        </a>
    </div>
</div>

@section Scripts {
    <script>
        function clearFilters() {
            document.getElementById('positionFilter').value = '';
            document.getElementById('employmentTypeFilter').value = '';
            filterTable();
        }
        
        function filterTable() {
            const positionFilter = document.getElementById('positionFilter').value.toLowerCase();
            const employmentTypeFilter = document.getElementById('employmentTypeFilter').value;
            const rows = document.querySelectorAll('.employee-row');
            
            rows.forEach(row => {
                const position = (row.getAttribute('data-position') || '').toLowerCase();
                const employmentType = row.getAttribute('data-employment-type') || '';
                
                const positionMatch = !positionFilter || position.includes(positionFilter);
                const employmentTypeMatch = !employmentTypeFilter || employmentType === employmentTypeFilter;
                
                if (positionMatch && employmentTypeMatch) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }
        
        document.getElementById('positionFilter').addEventListener('change', filterTable);
        document.getElementById('employmentTypeFilter').addEventListener('change', filterTable);
    </script>
}
